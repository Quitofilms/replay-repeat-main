{
  "name": "replay-repeat",
  "version": "0.0.0",
  "private": true,
  "description": "Replay a video: press a number key to go back that many seconds, loop the whole video, or loop a range between two markers.",
  "repository": "https://github.com/NullVoxPopuli/replay-repeat",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "start": "vite",
    "lint:eslint": "eslint . --cache",
    "lint:eslint:fix": "eslint . --fix",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "format": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "testem ci --port 0",
    "test": "pnpm build:test && pnpm test:ci",
    "lint:types": "tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@embroider/macros": "^1.21.4",
    "@embroider/router": "^3.0.6",
    "@glimmer/component": "^2.2.1",
    "decorator-transforms": "^2.4.0",
    "ember-modifier": "^4.3.0",
    "ember-primitives": "^0.64.1",
    "ember-source": "~7.4.0",
    "nvp.ui": "^0.12.0",
    "reactiveweb": "^1.9.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@babel/runtime": "^7.29.13",
    "@ember/app-tsconfig": "^2.1.0",
    "@ember/test-helpers": "^5.8.0",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/core": "^4.6.10",
    "@glint/ember-tsc": "^1.14.3",
    "@glint/template": "^1.11.1",
    "@iconify-json/mdi": "^1.2.3",
    "@nullvoxpopuli/ember-vite": "1.4.0",
    "@nullvoxpopuli/eslint-configs": "^7.1.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/qunit": "^2.19.14",
    "@types/youtube": "^0.3.0",
    "@typescript/native": "npm:typescript@^7.1.0-dev.20261105.1",
    "babel-plugin-debug-macros": "^2.0.0",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "concurrently": "^9.2.5",
    "ember-content-mapper": "^0.3.2",
    "ember-qunit": "^9.2.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-ember-template-tag": "^2.1.8",
    "qunit": "^2.26.0",
    "qunit-dom": "3.5.0",
    "qunit-theme-ember": "^1.0.0",
    "testem": "3.17.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  },
  "packageManager": "pnpm@10.28.0"
}
